<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Simulador web de Batalla Naval: juega contra la skill (local o en AWS) y hace de robot virtual -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>jose.coronel.cl</groupId>
    <artifactId>battleship-simulador</artifactId>
    <version>1.0.0</version>

    <properties>
        <java.version>25</java.version>
        <aws-sdk.version>2.57.11</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- La skill de Alexa (mvn install en la carpeta de arriba). Sin su logging de Lambda. -->
        <dependency>
            <groupId>jose.coronel.cl</groupId>
            <artifactId>alexa-batlla-naval</artifactId>
            <version>2.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.amazonaws</groupId>
                    <artifactId>aws-lambda-java-log4j2</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Modo "Lambda en AWS": invoca la Lambda desplegada -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>lambda</artifactId>
        </dependency>
        <!-- Permite usar las credenciales de "aws login" (inicio de sesión por navegador) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>signin</artifactId>
        </dependency>

        <!-- Robot virtual conectado a AWS IoT con los certificados del EV3 -->
        <dependency>
            <groupId>software.amazon.awssdk.iotdevicesdk</groupId>
            <artifactId>aws-iot-device-sdk</artifactId>
            <version>1.34.1</version>
        </dependency>

        <!-- Vue 3 para la página (servido localmente desde /webjars, sin internet) -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>vue</artifactId>
            <version>3.5.44</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
